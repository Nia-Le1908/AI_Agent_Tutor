# ================================================================
# AI Tutor - Environment Configuration (Phase 5 - Production Ready)
# ================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env file to version control!

# ================================================================
# LLM Configuration
# ================================================================
# DeepSeek API (primary LLM provider)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini API (alternative, if needed)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Ollama (local development)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5

# ================================================================
# Database Configuration
# ================================================================
# Database type: 'sqlite' (development) or 'postgresql' (production)
DB_TYPE=sqlite

# SQLite settings (used when DB_TYPE=sqlite)
SQLITE_DB_PATH=data/ai_tutor_v5.db

# PostgreSQL settings (used when DB_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_tutor
POSTGRES_USER=ai_tutor_user
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ================================================================
# Security & Authentication
# ================================================================
# JWT secret key for token signing (generate a random string for production)
# For production, use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Session timeout in hours
SESSION_TIMEOUT_HOURS=24

# ================================================================
# RAG Configuration
# ================================================================
# Chunk size for document processing (256-512 recommended)
CHUNK_SIZE=256

# Overlap between chunks
CHUNK_OVERLAP=50

# Number of chunks to retrieve for RAG
TOP_K=3

# Embedding model name
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ================================================================
# FAISS Vector Store
# ================================================================
FAISS_INDEX_PATH=vector_store/faiss_index.bin

# ================================================================
# Logging
# ================================================================
LOG_PATH=logs/app.log
LOG_LEVEL=INFO
# Enable RAG debug logging: true/false
DEBUG_RAG_CONTEXT=false

# ================================================================
# Application Settings
# ================================================================
# Streamlit server settings
STREAMLAT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_PORT=8501

# ================================================================
# Feature Flags
# ================================================================
# Enable/disable features
ENABLE_CHAT_HISTORY=true
ENABLE_ADAPTIVE_LEARNING=true
ENABLE_ANALYTICS=true
