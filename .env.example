# ================================================================
# AI Tutor - Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to source control!
# Every value below is validated at startup (config.py); an invalid value raises
# ConfigError naming the variable instead of failing later.

# ================================================================
# LLM Configuration (OpenAI-compatible provider)
# ================================================================
# DeepSeek API is the configured provider for chat and question generation.
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Request behaviour shared by chat and generation (llm_client.py).
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_ATTEMPTS=5
# LLM_INITIAL_BACKOFF_SECONDS=1.0
# LLM_BACKOFF_FACTOR=2.0
# LLM_MAX_BACKOFF_SECONDS=20
# Maximum questions per batch generation request (1-20).
# MAX_BATCH_SIZE=10

# ================================================================
# Database Configuration
# ================================================================
# Database type: 'sqlite' (development) or 'postgresql' (production)
DB_TYPE=sqlite

# SQLite settings (path is resolved relative to the project root)
DB_PATH=data/ai_tutor_v5.db
# SQLITE_TIMEOUT_SECONDS=10

# PostgreSQL settings (used when DB_TYPE=postgresql; requires psycopg2-binary)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=ai_tutor
# POSTGRES_USER=ai_tutor_user
# POSTGRES_PASSWORD=your-secure-password-here
# POSTGRES_POOL_SIZE=10
# POSTGRES_MAX_OVERFLOW=20

# ================================================================
# Security & Authentication (auth.py)
# ================================================================
# JWT secret key for token signing. Generate one for production with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leaving it unset uses an ephemeral per-process key (development only).
JWT_SECRET_KEY=
SESSION_TIMEOUT_HOURS=24
# Older builds stored unsalted SHA-256 password hashes. Keep this enabled until
# those accounts have logged in once (they are upgraded to bcrypt), then disable.
ALLOW_LEGACY_PASSWORD_FALLBACK=true

# ================================================================
# RAG Configuration
# ================================================================
# Chunk size for document processing (required range: 256-512)
CHUNK_SIZE=256
# Overlap between chunks (must be smaller than CHUNK_SIZE)
CHUNK_OVERLAP=50
# Number of chunks to retrieve for RAG
TOP_K=3
# Embedding model name
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ================================================================
# FAISS Vector Store
# ================================================================
FAISS_INDEX_PATH=vector_store/faiss_index.bin
VECTOR_DIR=vector_store
DATA_DIR=data

# ================================================================
# Logging
# ================================================================
LOG_PATH=logs/app.log
LOG_LEVEL=INFO
# Log retrieved chunk previews for each chat question: true/false
DEBUG_RAG_CONTEXT=false

# ================================================================
# Streamlit
# ================================================================
# Kept as comments: pass these on the command line or in a streamlit config file.
# streamlit run app.py --server.address 0.0.0.0 --server.port 8501
